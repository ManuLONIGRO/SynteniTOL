process {
    // use the image you pushed to Docker Hub
    container = 'docker.io/manulonigro/syntenitol:latest'
}

// optional: ensure docker backend is enabled
docker {
    enabled = true
}

timeline {
    enabled = true
    file = 'timeline.html'
    overwrite = true
}

report {
  enabled = true
  file = 'report.html'
  overwrite = true
}

trace {
  enabled = true
  file = 'trace.txt'
  overwrite = true
}

dag {
  enabled = true
  file = 'flowchart.png'
}