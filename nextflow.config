// Detect whether the NCBI API key is available as a Nextflow secret.
// Note: on the initial config load `secrets.X` evaluates to the literal
// placeholder string 'secrets.X' (truthy), so it must be filtered out
// explicitly; after Nextflow reloads the config with secrets enabled the
// access returns the actual secret value, or null when it is not set.
def ncbiSecretValue = null
try { ncbiSecretValue = secrets.NCBI_API_KEY } catch (Exception ignored) { /* secret store not available */ }
def ncbiApiKeyIsSecret = ncbiSecretValue != null && ncbiSecretValue != '' && ncbiSecretValue != 'secrets.NCBI_API_KEY'

process {
  // use the image you pushed to Docker Hub
    container = 'docker.io/manulonigro/syntenitol:latest'

  // Inject NCBI_API_KEY into the NCBI-facing processes only when it was set as
  // a Nextflow secret (`nextflow secrets set NCBI_API_KEY <key>`). Secrets are
  // resolved at runtime and never appear in .command.sh, run_command.txt,
  // report.html or trace.txt. When the secret is not set, the processes still
  // run without it: the scripts fall back to the stricter NCBI rate limits.
    withName: 'download_assemblies|download_cogs|fetch_genbank_records|efetch_to_tsv|get_taxonomy_info' {
        secret = ncbiApiKeyIsSecret ? ['NCBI_API_KEY'] : []
    }

  // Retry strategy
  withLabel: 'retry_backoff' {    
    errorStrategy = 'retry'
    maxRetries = 3
    
    // Exponential backoff
    beforeScript = {
      if( task.attempt > 1) {
        def delay = (int) (20 * Math.pow(2, task.attempt -2))
        "echo 'Retry attempt ${task.attempt-1}, sleeping ${delay}s' ; sleep ${delay}"
      } else {
        ''
      }
    }
  }
}

// optional: ensure docker backend is enabled
docker {
    enabled = true
    // Forward the NCBI API key from the host environment (export NCBI_API_KEY=...)
    // into the containers. `-e NAME` without a value is a pass-through: the key
    // itself is never written into any command line, report or trace file.
    runOptions = '-e NCBI_API_KEY'
}

params {
  // Simple defaults; CLI values override these
  help                = false
  inputFASTA          = null
  cogs                = null
  custom_hmm_profiles = null
  query_profile       = null
  gene_order          = null
  color_by_group      = ""
  no_taxonomy         = false
  only_fasta          = false
  window              = 30000
  base_name	          = null
  evalue              = 1e-5

  // Run ID and outdir default
  run_id = new Date().format('yyyyMMdd_HHmmss')
  outdir = "results/run_${params.run_id}"
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
    overwrite = true
}

report {
  enabled = true
  file = "${params.outdir}/report.html"
  overwrite = true
}

trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
  overwrite = true
}